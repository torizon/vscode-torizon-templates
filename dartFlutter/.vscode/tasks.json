{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ssh-tunnel",
            "type": "shell",
            "command": "sshpass",
            "args": [
                "-p", "${config:torizon_psswd}",
                "ssh",
                "-o",
                "PubkeyAuthentication=no",
                "-L", "42271:127.0.0.1:42271",
                "${config:torizon_login}@${config:torizon_ip}"
            ],
            "isBackground": true,
            "options": {
              "shell": {
                "executable": "/bin/bash",
                "args": ["-c"]
              }
            },
            "icon": {
                "id": "layers",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "flutter-clean-arm64",
            "detail": "Clean the build folder for arm64 using the\ncontainer SDK toolchain.",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "args": [
                "docker",
                "run",
                "--rm",
                "-v",
                "${workspaceFolder}:${config:torizon_app_root}",
                "cross-toolchain-arm64-__container__",
                "flutter-elinux",
                "clean"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "build-container-image-sdk-arm64"
            ],
            "icon": {
                "id": "trash",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "flutter-build-debug-arm64",
            "detail": "Builds the flutter app in debug configuration",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "args": [
                "docker",
                "run",
                "--rm",
                "-v",
                "${workspaceFolder}:${config:torizon_app_root}",
                "cross-toolchain-arm64-__container__",
                "./build-debug.sh"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "build-container-image-sdk-arm64"
            ],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "flutter-resolve-dependencies-local",
            "detail": "Run flutter pub get to resolve project dependecies",
            "command": "flutter-elinux",
            "type": "shell",
            "args": [
                "pub",
                "get",
                "&&",
                "sleep",
                "0.5"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
            ],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "flutter-clean-local",
            "detail": "Run flutter pub get to resolve project dependecies",
            "command": "flutter-elinux",
            "type": "shell",
            "args": [
                "clean"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
            ],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "deploy-torizon-arm64",
            "detail": "",
            "hide": true,
            "command": "rsync",
            "type": "process",
            "args": [
                "-P",
                "-av",
                "-e",
                "ssh -p ${config:torizon_debug_ssh_port} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null",
                "${workspaceFolder}/build/elinux/arm64/debug/bundle",
                "${config:torizon_run_as}@${config:torizon_ip}:${config:torizon_app_root}"
            ],
            "dependsOn": [
                "validate-settings",
                "validate-arch-arm64",
                "copy-docker-compose",
                "pre-cleanup",
                "flutter-build-debug-arm64",
                "build-container-torizon-debug-arm64",
                "push-container-torizon-debug-arm64",
                "pull-container-torizon-debug",
                "run-container-torizon-debug",
                "pos-cleanup",
                "ssh-check"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": "$msCompile",
            "icon": {
                "id": "debug-alt",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        }
    ],
    "inputs": []
}
