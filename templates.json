            "runtime": "TorizonCore Builder",
            "language": "YAML",
            "debugPort": "",
            "debugSSHPort": "",
            "multiContainer": true,
            "mergeCommon": {
                "tasks": [
                    "check-deps",
                    "fetch-templates-repo",
                    "try-update-template",
                    "try-update-template-accepting-all",
                    "run-docker-registry",
                    "run-docker-registry-wsl",
                    "run-torizon-binfmt",
                    "run-share-wsl-ports",
                    "platform-update-fleet",
                    "fill-pipeline-settings",
                    "validate-pipeline-settings",
                    "validate-json-files",
                    "show-project-documentation"
                ],
                "inputs": [
                    "archList"
                ]
            },
            "ignoreTorizonPackages": true,
            "support": "Torizon",
            "status": "ok",
            "customMessage": "",
            "customFields": [
                {
                    "id": "branch",
                    "label": "OSTree Branch Name",
                    "placeHolder": "myos/custom",
                    "default": "",
                    "type": "text",
                    "validRegex": "^(?!.*(?:^|\\/)(\\.\\.)(?:\\/|$))([A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$",
                    "errorMessage": "Invalid branch name. Must not be empty, start with /. Accepts alphanumeric characters, -, _, ., and /",
                    "description": "OSTree branch name to be used to commit the changes from the TCB project."
                }
            ]
        },
