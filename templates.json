        {
            "img": "tcb.png",
            "folder": "tcb",
            "description": "TorizonCore Builder Project",
            "runtime": "TorizonCore Builder",
            "language": "YAML",
            "debugPort": "",
            "debugSSHPort": "",
            "multiContainer": false,
            "mergeCommon": {
                "tasks": [
                    "check-deps",
                    "fetch-templates-repo",
                    "try-update-template",
                    "try-update-template-accepting-all",
                    "run-docker-registry",
                    "run-docker-registry-wsl",
                    "run-torizon-binfmt",
                    "run-share-wsl-ports",
                    "platform-update-fleet",
                    "fill-pipeline-settings",
                    "validate-pipeline-settings",
                    "validate-json-files",
                    "show-project-documentation"
                ],
                "inputs": [
                    "archList"
                ]
            },
            "tests": {
                "tasks": {
                    "run-tcb-in-terminal": "Setting up TorizonCore Builder",
                    "tcb-build": "Build command successfully executed",
                    "tcb-deploy": "Deploying successfully finished",
                    "tcb-isolate": "Changes in /etc successfully isolated",
                    "tcb-platform-push-ostree": "Signed and pushed OSTree package",
                    "tcb-dto-status": "Enabled overlays over unknown device tree",
                    "tcb-platform-provisioning-data-local": "successfully generated",
                    "tcb-platform-provisioning-data-online": "Online provisioning data:"
                }
            },
            "support": "Toradex",
            "status": "ok",
            "customMessage": "",
            "customFields": [
                {
                    "id": "branch",
                    "label": "OSTree Branch Name",
                    "placeHolder": "myos/custom",
                    "default": "",
                    "type": "text",
                    "validRegex": "^(?!.*(?:^|\\/)(\\.\\.)(?:\\/|$))([A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]+$",
                    "errorMessage": "Invalid branch name. Must not start with /, accepts alphanumeric characters, accepts -, _, ., and /",
                    "description": "OSTree branch name to be used to commit the changes from the TCB project."
                }
            ]
        },
