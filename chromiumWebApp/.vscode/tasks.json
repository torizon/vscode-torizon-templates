                "id": "debug-start",
                "color": "terminal.ansiGreen"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "deploy-torizon-amd64",
            "detail": "Deploy and debug on amd64",
            "hide": true,
